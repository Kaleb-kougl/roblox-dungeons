# Editor defaults that match .prettierrc (tabs, width 4, 120 columns) and the tree's existing style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

# Python generators follow PEP 8; TOML and YAML do not take tabs.
[*.{py,toml,yml,yaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Markdown: two trailing spaces are a line break, and tables / nested lists are aligned with spaces.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 120

# Recorded data, never hand-formatted.
[{fixtures/**,package-lock.json}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
max_line_length = unset
