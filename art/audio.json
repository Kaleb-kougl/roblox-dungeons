{
	"$comment": "Audio pipeline config (docs/FX_AUDIO.md A0 / A1; scripts/audio/build-audio.js). Paths are relative to art/vendor/. Each sound ID: category (sfx | jingle | music | ambience), clips (several = variants, played round-robin; a clip is a path or { src, gainDb?, trim?: [startSec, endSec?], mix?: [paths layered on src], lowpassHz? }), volume (0..1, the SoundAsset volume), pitch ([min, max] PlaybackSpeed jitter), minInterval (seconds, overrides the code's default), gainDb (on top of the category's normalisation), confirmed (false until the owner picked it by ear), alternates (listed on the audition page), notes. \"silent\": true leaves the ID silent. After editing: npm run audio:lock, npm run audio:build, npm run audio:audition.",
	"output": {
		"$comment": "Vorbis at a fixed quality. Lossy encoding overshoots transients: a decoded sample peak above maxDecodedPeakDb is re-encoded with the gain lowered by the overshoot plus peakStepDb (at most peakPasses encodes).",
		"codec": "libvorbis",
		"quality": 5,
		"sampleRate": 44100,
		"maxDecodedPeakDb": -0.3,
		"peakStepDb": 0.1,
		"peakPasses": 4
	},
	"limits": {
		"$comment": "Roblox audio upload limits: under 20 MB, under 7 minutes, 48 kHz or lower.",
		"maxBytes": 20000000,
		"maxSeconds": 420,
		"maxSampleRate": 48000
	},
	"silence": {
		"$comment": "Silence trim (sfx and jingles): threshold, and how much silence to keep before the onset and after the end.",
		"thresholdDb": -50,
		"keepStartSec": 0.005,
		"keepEndSec": 0.02
	},
	"categories": {
		"sfx": {
			"channels": 1,
			"trimSilence": true,
			"normalize": {
				"mode": "peak",
				"peakDb": -1,
				"windowDb": 1
			}
		},
		"jingle": {
			"channels": 2,
			"trimSilence": true,
			"normalize": {
				"mode": "peak",
				"peakDb": -1,
				"windowDb": 1
			}
		},
		"music": {
			"channels": 2,
			"trimSilence": false,
			"normalize": {
				"mode": "loudnorm",
				"lufs": -18,
				"truePeakDb": -1.5,
				"lra": 11,
				"windowLu": 1
			}
		},
		"ambience": {
			"channels": 2,
			"trimSilence": false,
			"normalize": {
				"mode": "loudnorm",
				"lufs": -18,
				"truePeakDb": -1.5,
				"lra": 11,
				"windowLu": 1
			}
		}
	},
