# Compiled Luau output: regenerated by `npm run build`, never edited by hand.
/out

# Dependencies
/node_modules
.npm-cache

# roblox-ts runtime shim, emitted by rbxtsc alongside out/
/include

# Generated from fixtures/*.json by scripts/gen-fixtures.js (runs before build/typecheck/test)
/src/shared/fixtures-generated

# Build artifacts
*.tsbuildinfo
flamework.build
/build

# Roblox place and model files (binary, do not diff or merge)
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# OS / editor
.DS_Store
Thumbs.db
build/

# Third-party art packs (licences forbid redistributing the raw files; see art/README.md) and pipeline output
# (art/build: atlases + contact sheets; art/upload: the flat folder of PNGs to upload)
/art/vendor
/art/build
/art/upload

# Localization pipeline output (docs/LOCALIZATION.md L10): the English dump (npm run l10n:dump) and the CSVs to
# upload to the Roblox cloud table (npm run l10n:export)
/l10n/build
/l10n/out

# Rollback spike captures and probe rows pulled from Studio (scripts/rollback/receive-captures.js; docs/ROLLBACK_SPIKE.md R4)
/captures
