{
	"name": "roblox-dungeons",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json",
		"**/*.spec.luau",
		"**/*.spec.lua",
		"**/fixtures-generated/**",
		"**/fixtures-generated",
		"node_modules/@rbxts-js/jest*",
		"node_modules/@rbxts-js/jest*/**",
		"node_modules/@rbxts-js/expect",
		"node_modules/@rbxts-js/expect/**",
		"node_modules/@rbxts-js/test-utils/**",
		"node_modules/@rbxts-js/test-utils",
		"node_modules/@rbxts/jest*",
		"node_modules/@rbxts/jest*/**",
		"node_modules/@rbxts/jest-matcher-utils/**"
	],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$ignoreUnknownInstances": true,
			"TS": {
				"$path": "out/server"
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"$ignoreUnknownInstances": true
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"$ignoreUnknownInstances": true,
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@flamework": {
						"$path": "node_modules/@flamework"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$ignoreUnknownInstances": true
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		},
		"Players": {
			"$className": "Players",
			"$properties": {
				"CharacterAutoLoads": false
			}
		}
	}
}
